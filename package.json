{
  "name": "opis",
  "productName": "OPIS",
  "version": "1.1.9",
  "description": "COMPSCI 399 project repository for Team 9 - JEDEJ",
  "main": "index.js",
  "author": "Team 9 JEDEJ",
  "desktopName": "opis.desktop",
  "license": "MIT",
  "devDependencies": {
    "prettier": "^3.9.6",
    "prettier-plugin-jinja-template": "^2.2.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3"
  },
  "overrides": {
    "tar": "7.5.21"
  },
  "scripts": {
    "tailwind": "npx @tailwindcss/cli -i ./src/ui/input.css -o ./dist/output.css",
    "watch": "npx @tailwindcss/cli -i ./src/ui/input.css -o ./dist/output.css --watch",
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "npm run tailwind && electron . dev",
    "bin": "electron .",
    "package-py-unix": "uv run --with pyinstaller pyinstaller --onefile --nowindow --clean --hidden-import=app --hidden-import=librebound ./src/backend/main.py && touch ./dist/main.exe",
    "package-py-win": "uv run --with pyinstaller pyinstaller --onefile --nowindow --clean --hidden-import=app --hidden-import=librebound .\\src\\backend\\main.py && echo \"\" > .\\dist\\main",
    "make": "electron-builder --publish never",
    "main": "uv run main.py"
  },
  "dependencies": {
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "@floating-ui/dom": "^1.8.0",
    "electron-log": "^5.4.4",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.8.9"
  }
}
