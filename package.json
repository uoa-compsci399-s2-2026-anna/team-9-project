{
  "name": "team-9-project",
  "version": "1.0.0",
  "description": "COMPSCI 399 project repository for Team 9 - JEDEJ",
  "main": "index.js",
  "author": "Team 9 JEDEJ",
  "license": "ISC",
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-dmg": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron/fuses": "^1.8.0",
    "electron": "^43.3.0",
    "prettier": "^3.9.6",
    "prettier-plugin-jinja-template": "^2.2.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3"
  },
  "overrides": {
    "tar": "7.5.21"
  },
  "scripts": {
    "tailwind": "npx @tailwindcss/cli -i ./src/ui/input.css -o ./dist/output.css",
    "watch": "npx @tailwindcss/cli -i ./src/ui/input.css -o ./dist/output.css --watch",
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "npm run tailwind && electron . dev",
    "bin": "electron .",
    "package-py-unix": "uv run --with pyinstaller pyinstaller --onefile --nowindow --clean --hidden-import=app --hidden-import=librebound main.py && touch ./dist/main.exe",
    "package-py-win": "uv run --with pyinstaller pyinstaller --onefile --nowindow --clean --hidden-import=app --hidden-import=librebound main.py && echo \"\" > .\\dist\\main",
    "make": "electron-forge make",
    "main": "uv run main.py"
  },
  "allowScripts": {
    "electron-winstaller@5.4.4": true
  },
  "dependencies": {
    "electron-squirrel-startup": "^1.0.1",
    "electron-store": "^8.2.0",
    "flatpickr": "^4.6.13"
  }
}
